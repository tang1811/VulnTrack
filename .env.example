# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องของตัวเอง (ห้าม commit ไฟล์ .env)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ใช้ MySQL: ตั้ง DB_ENGINE=mysql (ถ้าไม่ตั้ง ระบบจะใช้ SQLite)
DB_ENGINE=mysql
DB_NAME=eec_vulntrack
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
